{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft Pack Builder",
  "version": "0.1.0",
  "identifier": "com.mpb.minecraft-pack-builder",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Minecraft Pack Builder",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Local-first Minecraft modpack scheme builder",
    "longDescription": "Minecraft Pack Builder imports CurseForge modpacks, stores local schemes, exposes MCP-compatible AI tools, renders structures, validates changes, and exports Minecraft ecosystem files.",
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": null,
      "signingIdentity": null
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyQUQ3RURFMzVBQ0UyRDUKUldUVjRxdzEzbjZ0RWhXd3B6WFo0cHQvOUFiRUpXVENBeWdvWnUrU3AvajdFZlJqQm9uUmJDa2UK",
      "endpoints": [
        "https://github.com/Zenderg/minecraft-pack-builder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
